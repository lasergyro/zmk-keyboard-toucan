#include <behaviors.dtsi>
#include <behaviors/toucan_text.dtsi>
#include <behaviors/unicode.dtsi>
#include <zmk-helpers/helper.h>
#include <zmk-helpers/key-labels/42.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#include "leader.dtsi"
#include "mouse.dtsi"

#define BASE  0
#define NAV   1
#define FN    2
#define NUM   3
#define PAD   4
#define PAN   5
#define MEDIA 6

#define XXX &none
#define ___ &trans

#define QUICK_TAP_MS 175

/* Key-position groups for hold-trigger-key-positions */
#define KEYS_L LT5 LT4 LT3 LT2 LT1 LT0  LM5 LM4 LM3 LM2 LM1 LM0  LB5 LB4 LB3 LB2 LB1 LB0
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5  RM0 RM1 RM2 RM3 RM4 RM5  RB0 RB1 RB2 RB3 RB4 RB5
#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2

/* Unicode mode */
&uc {
    default-mode = <UC_MODE_MACOS>;
    minimum-length = <4>;
};

/* Timeless homerow mods */
#define MAKE_HRM(NAME, HOLD, TAP, TRIGGER_POS) \
    ZMK_HOLD_TAP(NAME, bindings = <HOLD>, <TAP>; flavor = "balanced"; \
        tapping-term-ms = <280>; quick-tap-ms = <QUICK_TAP_MS>; \
        require-prior-idle-ms = <200>; hold-trigger-on-release; \
        hold-trigger-key-positions = <TRIGGER_POS>;)

MAKE_HRM(hml, &kp, &kp, KEYS_R THUMBS)  /* left-hand HRMs  */
MAKE_HRM(hmr, &kp, &kp, KEYS_L THUMBS)  /* right-hand HRMs */

/* Paren mod-morphs: ( → < when shift held; ) → > when shift held */
#define SIMPLE_MORPH(NAME, MOD, BINDING1, BINDING2) \
    ZMK_MOD_MORPH(NAME, bindings = <BINDING1>, <BINDING2>; \
        mods = <(MOD_L##MOD|MOD_R##MOD)>;)

SIMPLE_MORPH(lpar_lt, SFT, &kp LPAR, &kp LT)
SIMPLE_MORPH(rpar_gt, SFT, &kp RPAR, &kp GT)

/* Namespace macros: trigger &leader then send the namespace key so leader
   dispatches the subsequent letter to the right sequence group. */
/ {
    behaviors {
        greek_ns: greek_namespace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <5>;
            bindings = <&leader>, <&kp L>;
        };
        german_ns: german_namespace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <5>;
            bindings = <&leader>, <&kp E>;
        };
        sys_ns: sys_namespace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <5>;
            bindings = <&leader>, <&kp N>;
        };
    };
};

#include "combos.dtsi"

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        media_layer {
            if-layers = <NAV NUM>;
            then-layer = <MEDIA>;
        };
    };
};

/* ── Layers ──────────────────────────────────────────────────────────────── */

ZMK_LAYER(Base,
// ╭───────────┬───────────┬───────────┬───────────┬───────────┬───────────╮ ╭───────────┬───────────┬───────────┬───────────┬───────────┬───────────╮
    &kp TAB     &kp Q       &kp W       &kp E       &kp R       &kp T           &kp Y       &kp U       &kp I       &kp O       &kp P       &kp BSPC
// ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤ ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤
    &kp ESC  &hml LGUI A &hml LALT S &hml LSHFT D &hml LCTRL F  &kp G          &kp H    &hmr LCTRL J &hmr RSHFT K &hmr LALT L &hmr LGUI SEMI &kp SQT
// ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤ ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤
    &kp GRAVE   &kp Z       &kp X       &kp C       &kp V       &kp B           &kp N       &kp M       &kp COMMA   &kp DOT     &kp FSLH    &kp K_APP
// ╰───────────┴───────────┴───────────┼───────────┼───────────┼───────────┤ ├───────────┼───────────┼───────────┼───────────┴───────────┴───────────╯
                                        &mo FN      &mo NAV     &kp SPACE       &kp RET     &kp BSPC    &mo NUM
//                                     ╰───────────┴───────────┴───────────╯ ╰───────────┴───────────┴───────────╯
)

ZMK_LAYER(Nav,
// ╭───────────┬───────────┬───────────┬───────────┬───────────┬───────────╮ ╭───────────┬───────────┬───────────┬───────────┬───────────┬───────────╮
    ___         ___         ___         ___         ___         ___             &kp PG_UP   &kp BSPC    &kp UP      &kp DEL     ___         ___
// ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤ ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤
    ___         &sk LGUI    &sk LALT    &sk LSHFT   &sk LCTRL   ___             &kp PG_DN   &kp LEFT    &kp DOWN    &kp RIGHT   &kp RET     ___
// ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤ ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤
    ___         ___         ___         ___         ___         ___             &kp INS     &kp TAB     ___         ___         ___         ___
// ╰───────────┴───────────┴───────────┼───────────┼───────────┼───────────┤ ├───────────┼───────────┼───────────┼───────────┴───────────┴───────────╯
                                        ___         ___         ___             ___         ___         ___
//                                     ╰───────────┴───────────┴───────────╯ ╰───────────┴───────────┴───────────╯
)

ZMK_LAYER(Fn,
// ╭───────────┬───────────┬───────────┬───────────┬───────────┬───────────╮ ╭───────────┬───────────┬───────────┬───────────┬───────────┬───────────╮
    ___         &kp F1      &kp F2      &kp F3      &kp F10     ___             &kp C_VOL_DN &kp C_MUTE &kp C_VOL_UP ___        ___         ___
// ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤ ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤
    ___         &kp F4      &kp F5      &kp F6      &kp F11     ___             &kp LEFT    &kp DOWN    &kp UP      &kp RIGHT   ___         ___
// ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤ ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤
    ___         &kp F7      &kp F8      &kp F9      &kp F12     ___             ___         ___         ___         ___         ___         ___
