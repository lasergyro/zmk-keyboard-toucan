/* PAD layer — activated by BTN_TOUCH from touchpad driver (mo 4) */
ZMK_LAYER(Pad,
// ╭───────────┬───────────┬───────────┬───────────┬───────────┬───────────╮ ╭───────────┬───────────┬───────────┬───────────┬───────────┬───────────╮
    ___         ___         ___         ___         ___         ___             ___         ___         ___         ___         ___         ___
