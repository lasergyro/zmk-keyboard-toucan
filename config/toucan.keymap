#include <behaviors.dtsi>
#include <behaviors/toucan_text.dtsi>
#include <behaviors/unicode.dtsi>
#include <zmk-helpers/helper.h>
#include <zmk-helpers/key-labels/42.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#include "leader.dtsi"
#include "mouse.dtsi"

#define BASE  0
#define NAV   1
#define FN    2
#define PAD   3
#define PAN   4

#define XXX &none
#define ___ &trans

#define QUICK_TAP_MS 175

/* Key-position groups for hold-trigger-key-positions */
#define KEYS_L LT5 LT4 LT3 LT2 LT1 LT0  LM5 LM4 LM3 LM2 LM1 LM0  LB5 LB4 LB3 LB2 LB1 LB0
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5  RM0 RM1 RM2 RM3 RM4 RM5  RB0 RB1 RB2 RB3 RB4 RB5
#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2

/* Unicode mode */
&uc {
    default-mode = <UC_MODE_MACOS>;
    minimum-length = <4>;
};

/* Timeless homerow mods */
#define MAKE_HRM(NAME, HOLD, TAP, TRIGGER_POS) \
    ZMK_HOLD_TAP(NAME, bindings = <HOLD>, <TAP>; flavor = "balanced"; \
        tapping-term-ms = <280>; quick-tap-ms = <QUICK_TAP_MS>; \
        require-prior-idle-ms = <200>; hold-trigger-on-release; \
        hold-trigger-key-positions = <TRIGGER_POS>;)

MAKE_HRM(hml, &kp, &kp, KEYS_R THUMBS)  /* left-hand HRMs  */
MAKE_HRM(hmr, &kp, &kp, KEYS_L THUMBS)  /* right-hand HRMs */

// Generate dedicated HRMs for morphs
#define MAKE_HRM_MORPH(NAME, HOLD, MORPH, TRIGGER_POS) \
    ZMK_HOLD_TAP(NAME, bindings = <HOLD>, <MORPH>; flavor = "balanced"; \
        tapping-term-ms = <280>; quick-tap-ms = <QUICK_TAP_MS>; \
        require-prior-idle-ms = <200>; hold-trigger-on-release; \
        hold-trigger-key-positions = <TRIGGER_POS>;)

MAKE_HRM_MORPH(hmr_comma_morph, &kp, &comma_morph, KEYS_L THUMBS)
MAKE_HRM_MORPH(hmr_dot_morph,   &kp, &dot_morph,   KEYS_L THUMBS)
MAKE_HRM_MORPH(hmr_qmark_morph, &kp, &qmark_morph, KEYS_L THUMBS)
MAKE_HRM_MORPH(hml_comma_morph, &kp, &comma_morph, KEYS_R THUMBS)
MAKE_HRM_MORPH(hml_dot_morph,   &kp, &dot_morph,   KEYS_R THUMBS)
MAKE_HRM_MORPH(hml_qmark_morph, &kp, &qmark_morph, KEYS_R THUMBS)

#define HMR_MORPH(MOD, TAP_BASE) &hmr_##TAP_BASE##_morph MOD 0
#define HML_MORPH(MOD, TAP_BASE) &hml_##TAP_BASE##_morph MOD 0

/* Paren mod-morphs: ( → < when shift held; ) → > when shift held */
#define SIMPLE_MORPH(NAME, MOD, BINDING1, BINDING2) \
    ZMK_MOD_MORPH(NAME, bindings = <BINDING1>, <BINDING2>; \
        mods = <(MOD_L##MOD|MOD_R##MOD)>;)

SIMPLE_MORPH(lpar_lt, SFT, &kp LPAR, &kp LT)
SIMPLE_MORPH(rpar_gt, SFT, &kp RPAR, &kp GT)

// Tap: comma | Shift + tap: semicolon
SIMPLE_MORPH(comma_morph, SFT, &kp COMMA, &kp SEMI)

// Tap: dot | Shift + tap: colon
SIMPLE_MORPH(dot_morph, SFT, &kp DOT, &kp COLON)

// Tap: single quote | Shift + tap: double quote
SIMPLE_MORPH(sqt_morph, SFT, &kp SQT, &kp DQT)

// Tap: qmark | Shift + tap: excl.
SIMPLE_MORPH(qmark_morph, SFT, &kp QMARK, &kp EXCL)


/* Namespace macros: trigger &leader then send the namespace key so leader
   dispatches the subsequent letter to the right sequence group. */
/ {
    behaviors {
        greek_ns: greek_namespace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <5>;
            bindings = <&leader>, <&kp L>;
        };
        german_ns: german_namespace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <5>;
            bindings = <&leader>, <&kp E>;
        };
        sys_ns: sys_namespace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <5>;
            bindings = <&leader>, <&kp N>;
        };
    };
};

#include "combos.dtsi"

/* ── Layers ──────────────────────────────────────────────────────────────── */

ZMK_LAYER(Base,
// ╭───────────┬───────────┬───────────┬───────────┬───────────┬───────────╮ ╭───────────┬───────────┬───────────┬───────────┬───────────┬───────────╮
    &kp TAB     &kp Q       &kp W       &kp E       &kp R       &kp T          &kp Y       &kp U       &kp I       &kp O       &kp P      &kp BSPC
// ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤ ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤
    &kp ESC  &hml LCTRL A &hml LALT S &hml LGUI D &hml LSHFT F  &kp G          &kp H    &hmr RSHFT J &hmr RGUI K &hmr RALT L HMR_MORPH(RCTRL, qmark) &kp K_APP
// ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤ ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤
    &kp LSHFT   &kp Z       &kp X       &kp C       &kp V       &kp B          &kp N       &kp M       &comma_morph   &dot_morph     &sqt_morph    &kp RSHFT
// ╰───────────┴───────────┴───────────┼───────────┼───────────┼───────────┤ ├───────────┼───────────┼───────────┼───────────┴───────────┴───────────╯
                                        &mo FN      &mo NAV     &kp SPACE      &kp RET     &kp BSPC    &mo FN
//                                     ╰───────────┴───────────┴───────────╯ ╰───────────┴───────────┴───────────╯
)

ZMK_LAYER(Nav,
// ╭───────────┬───────────┬───────────┬───────────┬───────────┬───────────╮ ╭───────────┬───────────┬───────────┬───────────┬───────────┬───────────╮
    ___          &kp C_VOL_DN &kp C_MUTE &kp C_VOL_UP &kp C_BRI_UP   ___       &kp PG_UP   ___         &kp UP      ___         ___         ___
// ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤ ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤
    ___          &hml LCTRL C_AC_SEARCH &hml LALT C_VOICE_COMMAND &hml LGUI C_AC_DESKTOP_SHOW_ALL_WINDOWS ___    ___      &kp PG_DN   &hmr RSHFT LEFT &hmr RGUI DOWN &hmr RALT RIGHT ___         ___
// ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤ ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤
    ___          &kp C_PREV  &kp C_PP    &kp C_NEXT  &kp C_BRI_DN    ___       &kp INS     ___         ___         ___         ___         ___
// ╰───────────┴───────────┴───────────┼───────────┼───────────┼───────────┤ ├───────────┼───────────┼───────────┼───────────┴───────────┴───────────╯
                                        ___         ___         ___            ___         ___         ___
//                                     ╰───────────┴───────────┴───────────╯ ╰───────────┴───────────┴───────────╯
)

ZMK_LAYER(Fn,
// ╭───────────┬───────────┬───────────┬───────────┬───────────┬───────────╮ ╭───────────┬───────────┬───────────┬───────────┬───────────┬───────────╮
    ___         ___          &kp F1      &kp F2      &kp F3      &kp F10       ___         &kp N1      &kp N2      &kp N3      ___            &kp SYS_DND
// ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤ ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤
    ___         ___          &hml LALT F4 &hml LGUI F5 &hml LSHFT F6 &kp F11  ___         &hmr RSHFT N4 &hmr RGUI N5 &hmr RALT N6 &hmr RCTRL N0 ___
// ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤ ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤
    ___         ___          &kp F7      &kp F8      &kp F9      &kp F12       ___         &kp N7      &kp N8      &kp N9      ___            ___
// ╰───────────┴───────────┴───────────┼───────────┼───────────┼───────────┤ ├───────────┼───────────┼───────────┼───────────┴───────────┴───────────╯
                                        ___         ___         ___           ___         ___         ___
//                                     ╰───────────┴───────────┴───────────╯ ╰───────────┴───────────┴───────────╯
)

/* PAD layer — activated by BTN_TOUCH from touchpad driver (mo 5) */
ZMK_LAYER(Pad,
// ╭───────────┬───────────┬───────────┬───────────┬───────────┬───────────╮ ╭───────────┬───────────┬───────────┬───────────┬───────────┬───────────╮
    ___         ___         ___         ___         ___         ___             ___         ___         ___         ___         ___         ___
// ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤ ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤
    ___         ___         ___         ___         ___         ___             ___         ___         &mo PAN     ___         ___         ___
// ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤ ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤
    ___         ___         ___         ___         ___         ___             ___         ___         ___         ___         ___         ___
// ╰───────────┴───────────┴───────────┼───────────┼───────────┼───────────┤ ├───────────┼───────────┼───────────┼───────────┴───────────┴───────────╯
                                        &mkp LCLK   &mkp MCLK   &mkp RCLK       ___         ___         ___
//                                     ╰───────────┴───────────┴───────────╯ ╰───────────┴───────────┴───────────╯
)

/* PAN layer — held from PAD K; input-listener layer override maps XY → scroll */
ZMK_LAYER(Pan,
// ╭───────────┬───────────┬───────────┬───────────┬───────────┬───────────╮ ╭───────────┬───────────┬───────────┬───────────┬───────────┬───────────╮
    ___         ___         ___         ___         ___         ___             ___         ___         ___         ___         ___         ___
// ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤ ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤
    ___         ___         ___         ___         ___         ___             ___         ___         ___         ___         ___         ___
// ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤ ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤
    ___         ___         ___         ___         ___         ___             ___         ___         ___         ___         ___         ___
// ╰───────────┴───────────┴───────────┼───────────┼───────────┼───────────┤ ├───────────┼───────────┼───────────┼───────────┴───────────┴───────────╯
                                        ___         ___         ___             ___         ___         ___
