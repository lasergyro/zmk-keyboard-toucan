                                        &mkp LCLK   &mkp MCLK   &mkp RCLK       ___         ___         ___
//                                     ╰───────────┴───────────┴───────────╯ ╰───────────┴───────────┴───────────╯
)

/* PAN layer — held from PAD K; input-listener layer override maps XY → scroll */
ZMK_LAYER(Pan,
// ╭───────────┬───────────┬───────────┬───────────┬───────────┬───────────╮ ╭───────────┬───────────┬───────────┬───────────┬───────────┬───────────╮
    ___         ___         ___         ___         ___         ___             ___         ___         ___         ___         ___         ___
// ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤ ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤
    ___         ___         ___         ___         ___         ___             ___         ___         ___         ___         ___         ___
// ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤ ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤
    ___         ___         ___         ___         ___         ___             ___         ___         ___         ___         ___         ___
// ╰───────────┴───────────┴───────────┼───────────┼───────────┼───────────┤ ├───────────┼───────────┼───────────┼───────────┴───────────┴───────────╯
                                        ___         ___         ___             ___         ___         ___
//                                     ╰───────────┴───────────┴───────────╯ ╰───────────┴───────────┴───────────╯
)

/* MEDIA layer — activated by Nav+Num (conditional layer).
   Maps MacBook F-key shortcuts to the same positions as the Fn layer:
   F1→BriDn  F2→BriUp  F3→ShowAll  F10→Mute
   F4→Search F5→Dictation F6→none  F11→VolDn
   F7→Prev   F8→Play    F9→Next    F12→VolUp */

ZMK_LAYER(Media,
// ╭───────────┬───────────┬───────────┬───────────┬───────────┬───────────╮ ╭───────────┬───────────┬───────────┬───────────┬───────────┬───────────╮
    ___         &kp C_BRI_DN &kp C_BRI_UP &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS &kp C_MUTE ___            ___         ___         ___         ___         ___         ___
// ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤ ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤
    ___        &kp C_AC_SEARCH &kp C_VOICE_COMMAND ___ &kp C_VOL_DN ___           ___         ___         ___         ___         ___         ___
// ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤ ├───────────┼───────────┼───────────┼───────────┼───────────┼───────────┤
    ___         &kp C_PREV  &kp C_PP    &kp C_NEXT  &kp C_VOL_UP ___            ___         ___         ___         ___         ___         ___
// ╰───────────┴───────────┴───────────┼───────────┼───────────┼───────────┤ ├───────────┼───────────┼───────────┼───────────┴───────────┴───────────╯
                                        ___         ___         ___             ___         ___         ___
//                                     ╰───────────┴───────────┴───────────╯ ╰───────────┴───────────┴───────────╯
)
