/*                KEY POSITIONS (42-key toucan)

  ╭────────────────────────────────────────╮ ╭────────────────────────────────────────╮
  │  LT5  LT4  LT3  LT2  LT1  LT0         │ │         RT0  RT1  RT2  RT3  RT4  RT5   │
  │  LM5  LM4  LM3  LM2  LM1  LM0         │ │         RM0  RM1  RM2  RM3  RM4  RM5   │
  │  LB5  LB4  LB3  LB2  LB1  LB0         │ │         RB0  RB1  RB2  RB3  RB4  RB5   │
  ╰───────────────────╮  LH2  LH1  LH0    │ │    RH0  RH1  RH2  ╭───────────────────╯
                      ╰───────────────────╯ ╰───────────────────╯                     */

#define COMBO_TERM_FAST (18 * 4)
#define COMBO_TERM_SLOW (30 * 4)
#define COMBO_IDLE_FAST 150
#define COMBO_IDLE_SLOW 50

/* ── Homerow-mod chords vs. combos ───────────────────────────────────────────
   Every adjacent pair of homerow mods (S+D, D+F, J+K, K+L) is also a combo.
   Combos capture the key-position events before the keymap sees them, so the
   combo always wins over the hold-taps and a *held* chord emitted a repeating
   combo keycode instead of the two modifiers.

   Binding those combos to a hold-tap restores the intent:
     tap  → the combo (symbol / namespace)
     hold → both modifiers of the pair, held until release.
   The mods are pressed as explicit &kp so they survive other keys being
   pressed and released while the chord is down (implicit mods would not). */

#define MODS_PAIR(NAME, MOD1, MOD2) \
    ZMK_BEHAVIOR(NAME, macro, wait-ms = <0>; tap-ms = <0>; \
        bindings = <&macro_press &kp MOD1 &kp MOD2>, \
                   <&macro_pause_for_release>, \
                   <&macro_release &kp MOD1 &kp MOD2>;)

MODS_PAIR(mods_alt_gui,   LALT,  LGUI)   /* left  S+D */
MODS_PAIR(mods_gui_sft,   LGUI,  LSHFT)  /* left  D+F */
MODS_PAIR(mods_rsft_rgui, RSHFT, RGUI)   /* right J+K */
MODS_PAIR(mods_rgui_ralt, RGUI,  RALT)   /* right K+L */

/* Same positional veto as the homerow mods themselves: a same-hand key pressed
   after the chord means you were not chording modifiers, so fall back to the tap. */
#define MAKE_COMBO_HRM(NAME, MODS, TAP, TRIGGER_POS) \
    ZMK_HOLD_TAP(NAME, bindings = <MODS>, <TAP>; flavor = "balanced"; \
        tapping-term-ms = <280>; quick-tap-ms = <QUICK_TAP_MS>; \
        require-prior-idle-ms = <200>; \
        hold-trigger-key-positions = <TRIGGER_POS>;)

MAKE_COMBO_HRM(chrm_tab,    &mods_alt_gui,   &kp,        KEYS_R THUMBS MODS_LH)
MAKE_COMBO_HRM(chrm_german, &mods_gui_sft,   &german_ns, KEYS_R THUMBS MODS_LH)
MAKE_COMBO_HRM(chrm_lpar,   &mods_rsft_rgui, &lpar_lt,   KEYS_L THUMBS MODS_RH)
MAKE_COMBO_HRM(chrm_lt,     &mods_rsft_rgui, &kp,        KEYS_L THUMBS MODS_RH)
MAKE_COMBO_HRM(chrm_rpar,   &mods_rgui_ralt, &rpar_gt,   KEYS_L THUMBS MODS_RH)
MAKE_COMBO_HRM(chrm_gt,     &mods_rgui_ralt, &kp,        KEYS_L THUMBS MODS_RH)

/* ── Horizontal combos – left hand ──────────────────────────────────────── */

ZMK_COMBO(esc,    &kp ESC,            LT3 LT2,    BASE NAV, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(tab,    &chrm_tab 0 LS(LA(TAB)), LM3 LM2, BASE NAV, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(cut,    &clipboard TOUCAN_CLIPBOARD_CUT,   LB3 LB1, BASE NAV, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(copy,   &clipboard TOUCAN_CLIPBOARD_COPY,  LB3 LB2, BASE NAV, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(paste,  &clipboard TOUCAN_CLIPBOARD_PASTE, LB2 LB1, BASE NAV, COMBO_TERM_FAST, COMBO_IDLE_FAST)

/* ── Horizontal combos – right hand ─────────────────────────────────────── */

ZMK_COMBO(bspc,   &kp BSPC,           RT1 RT2,    BASE NAV, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(del,    &kp DEL,            RT2 RT3,    BASE NAV, COMBO_TERM_FAST, COMBO_IDLE_FAST)

ZMK_COMBO(lpar,   &chrm_lpar 0 0,     RM1 RM2,    BASE,     COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(rpar,   &chrm_rpar 0 0,     RM2 RM3,    BASE,     COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(lt_c,   &chrm_lt 0 LT,      RM1 RM2,    NAV,          COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(gt_c,   &chrm_gt 0 GT,      RM2 RM3,    NAV,          COMBO_TERM_FAST, COMBO_IDLE_FAST)

ZMK_COMBO(lbkt,   &kp LBKT,           RB1 RB2,    BASE,     COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(rbkt,   &kp RBKT,           RB2 RB3,    BASE,     COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(lbrc,   &kp LBRC,           RB1 RB2,    NAV,          COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(rbrc,   &kp RBRC,           RB2 RB3,    NAV,          COMBO_TERM_FAST, COMBO_IDLE_FAST)

/* ── Namespace combos (BASE only) ────────────────────────────────────────── */

ZMK_COMBO(greek_combo,  &greek_ns,    RM0 RM1,    BASE,         COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(german_combo, &chrm_german 0 0, LM2 LM1, BASE,        COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(sys_combo,    &sys_ns,      LB1 LB0,    BASE,         COMBO_TERM_FAST, COMBO_IDLE_FAST)

/* ── Vertical combos – left hand ─────────────────────────────────────────── */

ZMK_COMBO(at,     &kp AT,             LT3 LM3,    BASE NAV, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(hash,   &kp HASH,           LT2 LM2,    BASE NAV, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(dllr,   &kp DLLR,           LT1 LM1,    BASE NAV, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(prcnt,  &kp PRCNT,          LT0 LM0,    BASE NAV, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)

ZMK_COMBO(grave,  &kp GRAVE,          LM3 LB3,    BASE NAV, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(bslh,   &kp BSLH,           LM2 LB2,    BASE NAV, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(equal,  &kp EQUAL,          LM1 LB1,    BASE NAV, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(tilde,  &kp TILDE,          LM0 LB0,    BASE NAV, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)

/* ── Vertical combos – right hand ────────────────────────────────────────── */

ZMK_COMBO(caret,  &kp CARET,          RT0 RM0,    BASE NAV, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(plus,   &kp PLUS,           RT1 RM1,    BASE NAV, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(star,   &kp STAR,           RT2 RM2,    BASE NAV, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(amps,   &kp AMPS,           RT3 RM3,    BASE NAV, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)

ZMK_COMBO(under,  &kp UNDER,          RM0 RB0,    BASE NAV, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(minus,  &kp MINUS,          RM1 RB1,    BASE NAV, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(fslh,   &kp FSLH,           RM2 RB2,    BASE NAV, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(pipe,   &kp PIPE,           RM3 RB3,    BASE NAV, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
